# AI features are optional: the rule-based analysis works with no key at all.
# Set ONE of these to enable AI rewrite, grammar check, chat, and custom company/school analysis.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# If both keys are set, Anthropic is used unless you set AI_PROVIDER=openai
# AI_PROVIDER=anthropic
PORT=4000
